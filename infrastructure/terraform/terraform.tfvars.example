# Example configuration - Copy to terraform.tfvars and update values
# DO NOT commit terraform.tfvars to source control

environment       = "dev"
location          = "East US"
sql_admin_username = "sqladmin"
sql_admin_password = "CHANGE-ME-TO-STRONG-PASSWORD"
app_service_sku   = "B1"
sql_database_sku  = "Basic"

# Add your IP address to access SQL Server for migrations
allowed_ip_addresses = [
  # "1.2.3.4", # Your IP address
]

tags = {
  Application = "BudgetBuddy"
  ManagedBy   = "Terraform"
  Environment = "dev"
  Owner       = "DevTeam"
}
