{
  "name": "budgetbuddy",
  "version": "1.0.0",
  "description": "Full-stack budgeting application showcasing GitHub Copilot capabilities",
  "private": true,
  "scripts": {
    "self:audit": "node scripts/self-audit.js",
    "validate:copilot": "node scripts/validate-copilot-files.js",
    "validate:docs": "echo 'Documentation validation not yet implemented'",
    "backend:build": "cd src/backend && dotnet build",
    "backend:test": "cd src/backend && dotnet test",
    "frontend:build": "cd src/frontend && npm run build",
    "frontend:test": "cd src/frontend && npm test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "terraform:init": "cd infrastructure/terraform && terraform init",
    "terraform:validate": "cd infrastructure/terraform && terraform validate",
    "terraform:plan": "cd infrastructure/terraform && terraform plan"
  },
  "keywords": [
    "budgeting",
    "finance",
    "copilot",
    "dotnet",
    "react",
    "typescript"
  ],
  "author": "BudgetBuddy Team",
  "license": "MIT",
  "devDependencies": {
    "chalk": "^5.3.0"
  }
}
